{
  "name": "estetica-luciana-quintana",
  "main": "worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/signin-with-chatgpt"
    ]
  },
  "observability": {
    "enabled": false
  }
}